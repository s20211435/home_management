= form_with model: [@user, @schedule], local: true do |f|
  = render 'shared/error_messages', object: f.object

  .mb-3
    = f.label :title, 'タイトル', class: "form-label"
    = f.text_field :title, class: "form-control"

  .mb-3
    = f.label :description, '説明', class: "form-label"
    = f.text_area :description, class: "form-control"

  .mb-3
    = f.label :start_time, '開始時間', class: "form-label"
    = f.datetime_select :start_time, class: "form-control"

  .mb-3
    = f.label :end_time, '終了時間', class: "form-label"
    = f.datetime_select :end_time, class: "form-control"

  .actions.actions-buttons
    = f.submit '保存', class: "btn btn-primary m-3"
    = link_to 'キャンセル', user_schedules_path(@user), class: "btn btn-secondary m-3"

